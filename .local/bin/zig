#!/usr/bin/env bash
# vim: noet

if [ -z "$ZIG_RUNTIME" ]; then
	ZIG_DIR="$(find "$ZIG_HOME" -type d -name "zig-linux-$(uname -m)-*" | sort -r | head -n1)"
else
	ZIG_DIR="$ZIG_HOME/$ZIG_RUNTIME"
	if [ ! -d "$ZIG_DIR" ]; then
		echo "zig version $ZIG_VERSION not found"
		exit 1
	fi
fi

if [ ! -x "$ZIG_DIR/zig" ]; then
	echo "zig not found in $ZIG_DIR"
	exit 1
fi

exec "$ZIG_DIR/zig" "$@"
