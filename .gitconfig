# vim:noet:ts=4:sts=4
[core]
	editor = nvim
[user]
	name = pseudoc
	email = atlas.yu@canonical.com
	signingKey = 2971B988CC350CAC0728420B3EF18CAD891965D5
[url "git@github.com:"]
	insteadof = gh:
[url "git+ssh://pseudoc@git.launchpad.net/"]
	insteadof = lp:
[init]
	defaultBranch = main
[gpg]
	program = gpg2
[commit]
	gpgSign = true
[alias]
	lol = log --oneline
	root = rev-parse --show-toplevel
	exec = "!exec "
	kdiff = difftool --no-symlinks --dir-diff
[pull]
	rebase = true
[sendemail]
	from = Atlas Yu <atlas.yu@canonical.com>
	smtpServer = /home/catlas/go/bin/sendgmail
	smtpServerOption = -sender=atlas.yu@canonical.com
	chainReplyTo = false

[diff]
	tool = kitty
	guitool = kitty.gui
[difftool]
	prompt = false
	trustExitCode = true
[difftool "kitty"]
	cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
	cmd = kitten diff $LOCAL $REMOTE
